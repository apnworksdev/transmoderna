---
import type { WorkMedia } from '../lib/sanity';
import { urlForSanityImage } from '../lib/sanity';
import PortfolioVideoPlayer from './PortfolioVideoPlayer.astro';
import SanityImage from './SanityImage.astro';

interface Props {
  media?: WorkMedia;
  title: string;
}

const { media, title } = Astro.props;
const youtubeId = media?.youtubeId;
const vimeoUrl = media?.url?.trim();
const videoSrc = media?.videoSrc;
const showVideo = Boolean(youtubeId || (vimeoUrl && videoSrc));
const showImage = Boolean(media?.image && !showVideo);
const poster =
  urlForSanityImage(media?.poster, { width: 2400 }) ?? (youtubeId ? undefined : media?.videoPoster);
---

{
  showVideo || showImage ? (
    <section class="page-portfolio-detail-media-item">
      {showVideo ? (
        <PortfolioVideoPlayer src={videoSrc} youtubeId={youtubeId} poster={poster} title={title} />
      ) : (
        <figure class="page-portfolio-detail-image">
          <SanityImage image={media?.image} altFallback={title} width={2400} loading="lazy" />
        </figure>
      )}
    </section>
  ) : null
}
